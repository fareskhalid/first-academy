APP_NAME="Course System Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost:8448
APP_PORT=8088
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
COMPOSE_PROJECT_NAME=course-system-staging
WWWUSER=1000
WWWGROUP=1000
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=course_system_staging
DB_USERNAME=course
DB_PASSWORD=local-course-password
DB_ROOT_PASSWORD=local-root-password
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=log
FILESYSTEM_DISK=local
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5178
VITE_HMR_HOST=localhost
BCRYPT_ROUNDS=12

APP_ENV_FILE=.env.staging
SESSION_COOKIE=course_staging_session
HTTPS_PORT=8448
STAGING_BIND=127.0.0.1
