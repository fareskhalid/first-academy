APP_NAME="Course System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://courses.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=mysqlX.serv00.com
DB_PORT=3306
DB_DATABASE=LOGIN_course_system
DB_USERNAME=LOGIN_course_system
DB_PASSWORD=replace-with-a-long-random-password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=course_system_session

CACHE_STORE=database
CACHE_PREFIX=course_system_production_cache_

QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=local
MAIL_MAILER=log
BCRYPT_ROUNDS=12

VITE_APP_NAME="${APP_NAME}"
